# This repo tracks only the HTML handbook files.

# Large media (411 MB; exceeds GitHub limits)
audio/

# Vercel deployment metadata
.vercel

# Build scripts, docs (non-content)
# NOTE: _build_index.py, _handbook_template.html and _chapters_data.py are NOT
# listed here (and ARE tracked) — CI (.github/workflows/build-check.yml) needs
# them present to rebuild handbook.html and verify it's not stale, and
# _build_index.py now imports the shared track/chapter tables from
# _chapters_data.py (also used by the untracked _build_audiobook.py below).
_build_audiobook.py
HOW-TO-MAKE-AUDIOBOOK.md
_local_vercel_sim.py
_f15/

# Python bytecode cache (created by importing _chapters_data.py etc.)
__pycache__/
*.pyc

# Deployment config
# NOTE: vercel.json IS tracked — the GitHub-connected Vercel deploy needs it
# for the "/" -> handbook.html rewrite.
.vercelignore

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
